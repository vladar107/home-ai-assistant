#!/usr/bin/env bash

set -euo pipefail

source_image=${1:-}
host=${2:-${HOME_AGENT_DEPLOY_HOST:-home-nas}}
env_file=${3:-deploy/.env.nas}

if [[ ! $source_image =~ ^ghcr\.io/[a-z0-9][a-z0-9._/-]*@sha256:[a-f0-9]{64}$ ]]; then
  echo "usage: $0 ghcr.io/owner/image@sha256:<64 lowercase hex characters> [ssh-alias] [env-file]" >&2
  exit 2
fi
if [[ ! $host =~ ^[A-Za-z0-9][A-Za-z0-9._@-]*$ ]]; then
  echo "invalid SSH host or alias: $host" >&2
  exit 2
fi

repo_root=$(git rev-parse --show-toplevel)
if [[ $env_file != /* ]]; then
  env_file=$repo_root/$env_file
fi
if [[ ! -f $env_file ]]; then
  echo "NAS environment file not found: $env_file" >&2
  exit 2
fi

mode=$(stat -f '%Lp' "$env_file")
if (( (8#$mode & 077) != 0 )); then
  echo "NAS environment file must not be accessible by group or others: $env_file" >&2
  exit 2
fi

if [[ -n $(git -C "$repo_root" status --porcelain -- Dockerfile go.mod go.sum cmd internal deploy) ]]; then
  echo "deployment inputs must match the checked-out commit; commit or restore their changes first" >&2
  exit 2
fi

set -a
# shellcheck disable=SC1090
source "$env_file"
set +a

validate_path() {
  local name=$1
  local value=$2
  if [[ ! $value =~ ^/[A-Za-z0-9._/-]+$ || $value == / || $value == *'/../'* || $value == */.. ]]; then
    echo "$name must be a safe absolute NAS path without parent traversal" >&2
    exit 2
  fi
}

validate_path HOME_AGENT_NAS_ROOT "${HOME_AGENT_NAS_ROOT:-}"
for path_name in \
  HOME_AGENT_DATA_PATH \
  HOME_AGENT_SECRETS_PATH \
  ALLOY_DATA_PATH \
  PROMETHEUS_DATA_PATH \
  TEMPO_DATA_PATH \
  GRAFANA_DATA_PATH \
  GRAFANA_SECRETS_PATH; do
  validate_path "$path_name" "${!path_name:-}"
done
for numeric in "${NAS_RUNTIME_UID:-}" "${NAS_RUNTIME_GID:-}"; do
  if [[ ! $numeric =~ ^[0-9]+$ ]]; then
    echo "NAS_RUNTIME_UID and NAS_RUNTIME_GID must be numeric" >&2
    exit 2
  fi
done

revision=$(git -C "$repo_root" rev-parse HEAD)
digest=${source_image##*@sha256:}
local_image="home-ai-assistant:deploy-${digest:0:16}"
release_dir="$HOME_AGENT_NAS_ROOT/releases/${revision}-${digest:0:12}"

echo "Pulling $source_image for linux/amd64." >&2
docker pull --platform linux/amd64 "$source_image"

architecture=$(docker image inspect --format '{{.Architecture}}' "$source_image")
image_revision=$(docker image inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$source_image")
if [[ $architecture != amd64 ]]; then
  echo "image architecture is $architecture, expected amd64" >&2
  exit 1
fi
if [[ $image_revision != "$revision" ]]; then
  echo "image revision $image_revision does not match checked-out commit $revision" >&2
  exit 1
fi

docker image tag "$source_image" "$local_image"

ssh -o BatchMode=yes "$host" sh -s -- \
  "$HOME_AGENT_NAS_ROOT" \
  "$release_dir" \
  "$NAS_RUNTIME_UID" \
  "$NAS_RUNTIME_GID" \
  "$HOME_AGENT_DATA_PATH" \
  "$HOME_AGENT_SECRETS_PATH" \
  "$ALLOY_DATA_PATH" \
  "$PROMETHEUS_DATA_PATH" \
  "$TEMPO_DATA_PATH" \
  "$GRAFANA_DATA_PATH" \
  "$GRAFANA_SECRETS_PATH" <<'REMOTE'
set -eu
root=$1
release=$2
runtime_uid=$3
runtime_gid=$4
shift 4
umask 077
test "$(id -u)" = "$runtime_uid"
test "$(id -g)" = "$runtime_gid"

validate_directory() {
  directory=$1
  test -d "$directory"
  test ! -L "$directory"
  test "$(stat -c %a "$directory")" = 700
  test "$(stat -c %u "$directory")" = "$runtime_uid"
  test "$(stat -c %g "$directory")" = "$runtime_gid"
}

validate_directory "$root"
for directory in "$root/releases" "$release"; do
  if test -e "$directory" || test -L "$directory"; then
    validate_directory "$directory"
  else
    mkdir -m 700 "$directory"
  fi
done
for directory do
  validate_directory "$directory"
done
docker info >/dev/null
docker compose version >/dev/null
REMOTE

echo "Streaming the selected image to $host without creating an archive." >&2
docker image save "$local_image" | ssh -o BatchMode=yes "$host" docker image load

while IFS= read -r tracked_file; do
  relative_path=${tracked_file#deploy/}
  if [[ ! $relative_path =~ ^[A-Za-z0-9._/-]+$ || $relative_path == *'/../'* || $relative_path == ../* ]]; then
    echo "refusing unsafe tracked deployment path: $tracked_file" >&2
    exit 1
  fi
  relative_directory=$(dirname "$relative_path")
  ssh -n -o BatchMode=yes "$host" "umask 077; mkdir -p '$release_dir/deploy/$relative_directory'"
  scp -q "$repo_root/$tracked_file" "$host:$release_dir/deploy/$relative_path"
done < <(git -C "$repo_root" ls-files deploy)

{
  grep -Ev '^HOME_AGENT_(IMAGE|VERSION)=' "$env_file"
  printf 'HOME_AGENT_IMAGE=%s\n' "$local_image"
  printf 'HOME_AGENT_VERSION=%s\n' "$revision"
} | ssh -o BatchMode=yes "$host" "umask 077; cat >'$release_dir/deploy/runtime.env'"

"$repo_root/scripts/nas-sync-secrets" "$host" "$env_file"

ssh -o BatchMode=yes "$host" bash -s -- \
  "$HOME_AGENT_NAS_ROOT" \
  "$release_dir" \
  "$local_image" \
  "$source_image" \
  "$HOME_AGENT_DATA_PATH" <<'REMOTE'
set -Eeuo pipefail

root=$1
release=$2
image=$3
source_image=$4
data_path=$5
attempt_id=$(date -u +%Y%m%dT%H%M%SZ)-$$
data_snapshot=$release/pre-upgrade-data-$attempt_id
compose=(docker compose --env-file "$release/deploy/runtime.env" -f "$release/deploy/compose.yaml")

case "$data_path" in
  "$root"/*) ;;
  *)
    echo "Home Agent data path must be inside the validated NAS root." >&2
    exit 1
    ;;
esac
test -d "$data_path"
test ! -L "$data_path"

rollback() {
  local status=$?
  trap - ERR
  if [[ -L $root/current && -f $root/current/deploy/runtime.env ]]; then
    echo "Deployment failed; restoring the previous Compose release." >&2
    if [[ -d $data_snapshot ]]; then
      echo "Restoring the pre-upgrade Home Agent data snapshot." >&2
      "${compose[@]}" stop home-agent || true
      test -d "$data_path"
      test ! -L "$data_path"
      find "$data_path" -mindepth 1 -maxdepth 1 -exec rm -rf -- {} +
      cp -a -- "$data_snapshot/." "$data_path/"
    fi
    if ! docker compose \
      --env-file "$root/current/deploy/runtime.env" \
      -f "$root/current/deploy/compose.yaml" \
      up -d; then
      echo "Rollback failed to start the previous Compose release." >&2
      exit 1
    fi
  else
    echo "Deployment failed before a previous release was available; leaving containers for inspection." >&2
  fi
  exit "$status"
}
trap rollback ERR

docker image inspect "$image" >/dev/null

cd "$release/deploy"
"${compose[@]}" config --quiet
"${compose[@]}" pull alloy prometheus tempo grafana
"${compose[@]}" up -d alloy prometheus tempo grafana

probe() {
  docker run --rm \
    --network home-ai-assistant \
    --entrypoint wget \
    "$image" \
    -q -T 5 -O /dev/null "$1"
}

wait_for() {
  local description=$1
  local url=$2
  local attempts=0
  until probe "$url"; do
    attempts=$((attempts + 1))
    if (( attempts >= 30 )); then
      echo "$description did not become ready" >&2
      return 1
    fi
    sleep 3
  done
}

wait_for Alloy http://alloy:12345/-/ready
wait_for Prometheus http://prometheus:9090/-/ready
wait_for Tempo http://tempo:3200/ready
wait_for Grafana http://grafana:3000/api/health

if [[ -L $root/current && -f $root/current/deploy/runtime.env ]]; then
  previous_compose=(
    docker compose
    --env-file "$root/current/deploy/runtime.env"
    -f "$root/current/deploy/compose.yaml"
  )
  echo "Stopping the previous Home Agent for a transaction-consistent data snapshot." >&2
  "${previous_compose[@]}" stop home-agent
  temporary_snapshot=$release/.pre-upgrade-data-$attempt_id
  test ! -e "$temporary_snapshot"
  test ! -e "$data_snapshot"
  mkdir -m 700 "$temporary_snapshot"
  cp -a -- "$data_path/." "$temporary_snapshot/"
  mv -- "$temporary_snapshot" "$data_snapshot"
fi

"${compose[@]}" up -d home-agent
wait_for home-agent http://home-agent:8080/readyz

metric_found=false
trace_found=false
for _ in {1..40}; do
  if metric_response=$(docker run --rm \
      --network home-ai-assistant \
      --entrypoint wget \
      "$image" \
      -q -T 5 -O - 'http://prometheus:9090/api/v1/query?query=home_agent_application_running'); then
    if grep -q '"result":\[{' <<<"$metric_response"; then
      metric_found=true
    fi
  fi

  if trace_response=$(docker run --rm \
      --network home-ai-assistant \
      --entrypoint wget \
      "$image" \
      -q -T 5 -O - 'http://tempo:3200/api/search?tags=service.name%3Dhome-agent&limit=1'); then
    if grep -q '"traces":\[{' <<<"$trace_response"; then
      trace_found=true
    fi
  fi

  if [[ $metric_found == true && $trace_found == true ]]; then
    break
  fi
  sleep 3
done

if [[ $metric_found != true || $trace_found != true ]]; then
  echo "application readiness passed, but metrics or traces did not reach their backend" >&2
  false
fi

printf '%s\n' "$source_image" >"$release/source-image"
chmod 600 "$release/source-image" "$release/deploy/runtime.env"
ln -sfn "$release" "$root/current"
trap - ERR

"${compose[@]}" ps
echo "Deployment verified and current release updated to $release." >&2
REMOTE
