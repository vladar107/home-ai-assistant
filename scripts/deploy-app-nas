#!/usr/bin/env bash
set -euo pipefail

usage() { echo "usage: $0 [ssh-host] [env-file]" >&2; exit 2; }
host=${1:-${HOME_AGENT_DEPLOY_HOST:-home-nas}}
env_file=${2:-deploy/.env.nas}
[[ $host =~ ^[A-Za-z0-9._@-]+$ ]] || usage
repo_root=$(git rev-parse --show-toplevel)
[[ $env_file = /* ]] || env_file=$repo_root/$env_file
[[ -f $env_file ]] || { echo "NAS environment file not found: $env_file" >&2; exit 2; }
mode=$(stat -f '%Lp' "$env_file")
(( (8#$mode & 077) == 0 )) || { echo "NAS environment file must not be accessible by group or others: $env_file" >&2; exit 2; }
if grep -Eq '^HOME_AGENT_TELEGRAM_BOT_TOKEN=' "$env_file"; then
  echo "runtime secret values must be stored in macOS Keychain, not $env_file" >&2
  exit 2
fi
# shellcheck disable=SC1090
source "$env_file"
for n in NAS_RUNTIME_UID NAS_RUNTIME_GID; do
  [[ ${!n:-} =~ ^[0-9]+$ ]] || { echo "$n must be numeric" >&2; exit 2; }
done
validate_path() {
  local name=$1 value=$2
  [[ $value =~ ^/[A-Za-z0-9._/-]+$ && $value != / && $value != *'/../'* && $value != */.. ]] || {
    echo "$name must be a safe absolute NAS path without parent traversal" >&2; exit 2;
  }
  [[ $value != /volume1/@docker && $value != /volume1/@docker/* ]] || {
    echo "$name must not use Docker's internal data directory: $value" >&2; exit 2;
  }
}
validate_path HOME_AGENT_NAS_ROOT "${HOME_AGENT_NAS_ROOT:-}"
for n in HOME_AGENT_CONFIG_PATH HOME_AGENT_DATA_PATH HOME_AGENT_SECRETS_PATH HOME_AGENT_TELEGRAM_USERS_FILE_PATH; do
  validate_path "$n" "${!n:-}"
  [[ ${!n} = "$HOME_AGENT_NAS_ROOT"/* ]] || { echo "$n must be below HOME_AGENT_NAS_ROOT" >&2; exit 2; }
done
[[ ${HOME_AGENT_IMAGE_REPOSITORY:-} =~ ^ghcr\.io/[a-z0-9][a-z0-9-]*/[a-z0-9._-]+$ ]] || {
  echo "HOME_AGENT_IMAGE_REPOSITORY must be a GHCR repository such as ghcr.io/owner/name" >&2; exit 2;
}
compose_files=(-f compose.app.yaml)
compose_inputs=(deploy/compose.app.yaml)
nas_enabled=${HOME_AGENT_NAS_ENABLED:-false}
if [[ $nas_enabled == true ]]; then
  compose_files+=(-f compose.app.nas.yaml)
  compose_inputs+=(deploy/compose.app.nas.yaml)
  validate_path HOME_AGENT_NAS_ROOTS_FILE_PATH "${HOME_AGENT_NAS_ROOTS_FILE_PATH:-}"
  [[ ${HOME_AGENT_NAS_ROOTS_FILE_PATH} = "$HOME_AGENT_NAS_ROOT"/* ]] || {
    echo "HOME_AGENT_NAS_ROOTS_FILE_PATH must be below HOME_AGENT_NAS_ROOT" >&2; exit 2;
  }
  # The mounted household directories live outside the deployment root and may sit below NAS OS
  # paths such as /volume1/@home, so they are validated on their own terms.
  for n in HOME_AGENT_NAS_PRIMARY_HOME_PATH HOME_AGENT_NAS_PRIMARY_INBOX_PATH \
    HOME_AGENT_NAS_SECOND_HOME_PATH HOME_AGENT_NAS_SECOND_INBOX_PATH \
    HOME_AGENT_NAS_SHARED_PATH HOME_AGENT_NAS_SHARED_INBOX_PATH; do
    value=${!n:-}
    [[ $value =~ ^/[A-Za-z0-9._/@-]+$ && $value != / && $value != *'/../'* && $value != */.. ]] || {
      echo "$n must be a safe absolute NAS path without parent traversal" >&2; exit 2;
    }
    [[ $value != "$HOME_AGENT_NAS_ROOT" && $value != "$HOME_AGENT_NAS_ROOT"/* ]] || {
      echo "$n must not mount the deployment's own directory: $value" >&2; exit 2;
    }
  done
fi
if [[ ${HOME_AGENT_GOOGLE_ENABLED:-false} == true ]]; then
  [[ ${HOME_AGENT_GOOGLE_CLIENT_ID:-} =~ ^[A-Za-z0-9._-]+\.apps\.googleusercontent\.com$ ]] || {
    echo "HOME_AGENT_GOOGLE_CLIENT_ID must be a Google OAuth client ID" >&2; exit 2;
  }
  compose_files+=(-f compose.app.google.yaml)
  compose_inputs+=(deploy/compose.app.google.yaml)
fi
if [[ ${HOME_AGENT_NS_ENABLED:-false} == true ]]; then
  compose_files+=(-f compose.app.ns.yaml)
  compose_inputs+=(deploy/compose.app.ns.yaml)
fi
if [[ ${HOME_AGENT_TYPESAFE_ENABLED:-false} == true ]]; then
  compose_files+=(-f compose.app.typesafe.yaml)
  compose_inputs+=(deploy/compose.app.typesafe.yaml)
fi

users_source=${HOME_AGENT_TELEGRAM_USERS_SOURCE:-deploy/telegram-users.json}
if [[ $users_source = /* ]]; then
  [[ $users_source =~ ^/[A-Za-z0-9._/-]+$ && $users_source != *'/../'* && $users_source != */.. ]] || { echo "unsafe Telegram users path" >&2; exit 2; }
else
  [[ $users_source =~ ^[A-Za-z0-9._/-]+$ && $users_source != ../* && $users_source != *'/../'* ]] || { echo "unsafe Telegram users path" >&2; exit 2; }
  users_source=$repo_root/$users_source
fi
[[ -f $users_source ]] || { echo "Telegram users file not found: $users_source" >&2; exit 2; }

if [[ $nas_enabled == true ]]; then
  roots_source=${HOME_AGENT_NAS_ROOTS_SOURCE:-deploy/nas-roots.json}
  if [[ $roots_source = /* ]]; then
    [[ $roots_source =~ ^/[A-Za-z0-9._/-]+$ && $roots_source != *'/../'* && $roots_source != */.. ]] || { echo "unsafe NAS roots path" >&2; exit 2; }
  else
    [[ $roots_source =~ ^[A-Za-z0-9._/-]+$ && $roots_source != ../* && $roots_source != *'/../'* ]] || { echo "unsafe NAS roots path" >&2; exit 2; }
    roots_source=$repo_root/$roots_source
  fi
  [[ -f $roots_source ]] || { echo "NAS roots file not found: $roots_source" >&2; exit 2; }
fi

for path in "${compose_inputs[@]}" scripts/image-tag; do
  [[ -z $(git -C "$repo_root" status --porcelain --untracked-files=all -- "$path") ]] || {
    echo "deployment input has uncommitted changes: $path" >&2; exit 2;
  }
done
git -C "$repo_root" fetch --quiet origin main
git -C "$repo_root" merge-base --is-ancestor HEAD origin/main || {
  echo "HEAD is not contained in origin/main; push it first because the CI image workflow only publishes pushed commits" >&2
  exit 2
}

revision=$(git -C "$repo_root" rev-parse HEAD)
release_tag=$("$repo_root/scripts/image-tag" "$revision")
tag_ref=$HOME_AGENT_IMAGE_REPOSITORY:$release_tag
deploy_dir=$HOME_AGENT_NAS_ROOT/deploy
tmp=$(mktemp -d "${TMPDIR:-/tmp}/home-agent-deploy.XXXXXX")
trap 'rm -rf "$tmp"' EXIT
ssh -o BatchMode=yes "$host" "test ! -L '$HOME_AGENT_NAS_ROOT' && test ! -L '$deploy_dir' && { umask 077; mkdir -p '$deploy_dir' '$HOME_AGENT_CONFIG_PATH'; }"
git -C "$repo_root" archive --format=tar HEAD "${compose_inputs[@]}" \
  | ssh -o BatchMode=yes "$host" "tar -xf - -C '$HOME_AGENT_NAS_ROOT'"
scp -O -q "$users_source" "$host:$HOME_AGENT_CONFIG_PATH/.telegram-users.json.deploy"
ssh -o BatchMode=yes "$host" "chmod 600 '$HOME_AGENT_CONFIG_PATH/.telegram-users.json.deploy' && mv -f '$HOME_AGENT_CONFIG_PATH/.telegram-users.json.deploy' '$HOME_AGENT_CONFIG_PATH/telegram-users.json'"
if [[ $nas_enabled == true ]]; then
  scp -O -q "$roots_source" "$host:$HOME_AGENT_NAS_ROOTS_FILE_PATH.deploy"
  ssh -o BatchMode=yes "$host" "chmod 600 '$HOME_AGENT_NAS_ROOTS_FILE_PATH.deploy' && mv -f '$HOME_AGENT_NAS_ROOTS_FILE_PATH.deploy' '$HOME_AGENT_NAS_ROOTS_FILE_PATH'"
fi

awk '
  /^[[:space:]]*#/ || /^[[:space:]]*$/ { print; next }
  /^[A-Za-z_][A-Za-z0-9_]*=/ {
    key=$0; sub(/=.*/, "", key)
    if (key == "HOME_AGENT_IMAGE" || key == "HOME_AGENT_IMAGE_TAG" || key == "HOME_AGENT_VERSION" || key == "HOME_AGENT_TELEGRAM_USER_ID" || key == "HOME_AGENT_TELEGRAM_USERS_SOURCE" || key == "HOME_AGENT_NAS_ROOTS_SOURCE") next
  }
  { print }
' "$env_file" > "$tmp/runtime.env"
printf 'HOME_AGENT_IMAGE_TAG=%s\nHOME_AGENT_TELEGRAM_USERS_FILE=/etc/home-agent/telegram-users.json\n' "$release_tag" >> "$tmp/runtime.env"
chmod 600 "$tmp/runtime.env"
scp -O -q "$tmp/runtime.env" "$host:$deploy_dir/.runtime.env.deploy"
ssh -o BatchMode=yes "$host" "chmod 600 '$deploy_dir/.runtime.env.deploy' && mv -f '$deploy_dir/.runtime.env.deploy' '$deploy_dir/runtime.env'"

"$repo_root/scripts/nas-sync-secrets" "$host" "$env_file"
remote_command=$(cat <<REMOTE
set -Eeuo pipefail
test ! -L '$HOME_AGENT_NAS_ROOT' && test ! -L '$deploy_dir'
test ! -L '$HOME_AGENT_CONFIG_PATH' && test ! -L '$HOME_AGENT_DATA_PATH' && test ! -L '$HOME_AGENT_SECRETS_PATH'
sudo mkdir -p '$HOME_AGENT_NAS_ROOT' '$deploy_dir' '$HOME_AGENT_CONFIG_PATH' '$HOME_AGENT_DATA_PATH' '$HOME_AGENT_SECRETS_PATH'
sudo chown '$NAS_RUNTIME_UID:$NAS_RUNTIME_GID' '$HOME_AGENT_NAS_ROOT' '$deploy_dir' '$HOME_AGENT_CONFIG_PATH' '$HOME_AGENT_DATA_PATH' '$HOME_AGENT_SECRETS_PATH'
sudo chmod 700 '$HOME_AGENT_NAS_ROOT' '$deploy_dir' '$HOME_AGENT_CONFIG_PATH' '$HOME_AGENT_DATA_PATH' '$HOME_AGENT_SECRETS_PATH'
test -f '$HOME_AGENT_CONFIG_PATH/telegram-users.json' && test ! -L '$HOME_AGENT_CONFIG_PATH/telegram-users.json' && chmod 600 '$HOME_AGENT_CONFIG_PATH/telegram-users.json'
cd '$deploy_dir'
sudo docker network inspect home-observability >/dev/null
if ! sudo docker pull '$tag_ref'; then
  echo 'could not pull $tag_ref' >&2
  echo 'if the image is not published yet, check: gh run list --workflow=image.yml --commit $revision' >&2
  echo 'if the registry login expired, run on the NAS: sudo docker login ghcr.io' >&2
  exit 1
fi
digest=\$(sudo docker image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' '$tag_ref' | grep -m1 '^$HOME_AGENT_IMAGE_REPOSITORY@sha256:' || true)
[ -n "\$digest" ] || { echo 'no $HOME_AGENT_IMAGE_REPOSITORY digest recorded for $tag_ref' >&2; exit 1; }
sudo docker compose -p home-ai-assistant --env-file runtime.env ${compose_files[*]} up -d home-agent
sudo docker compose -p home-ai-assistant --env-file runtime.env ${compose_files[*]} ps
printf '%s %s %s %s\\n' "\$(date -u +%Y-%m-%dT%H:%M:%SZ)" '$release_tag' "\$digest" '$revision' >> '$HOME_AGENT_NAS_ROOT/deployments.log'
chmod 600 '$HOME_AGENT_NAS_ROOT/deployments.log'
echo "deployed \$digest"
REMOTE
)
ssh -tt "$host" "$remote_command"

echo "Deployed $tag_ref from $deploy_dir on $host; the resolved digest is recorded in $HOME_AGENT_NAS_ROOT/deployments.log." >&2
