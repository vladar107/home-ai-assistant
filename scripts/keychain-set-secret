#!/usr/bin/env bash

set -euo pipefail

service=${1:-}
account=home-ai-assistant

case "$service" in
  home-agent.telegram-bot-token | home-agent.gmail-client-secret | typesafe.api-key | grafana.telegram-alert-bot-token | grafana.telegram-alert-chat-id)
    ;;
  *)
    echo "usage: $0 {home-agent.telegram-bot-token|home-agent.gmail-client-secret|typesafe.api-key|grafana.telegram-alert-bot-token|grafana.telegram-alert-chat-id}" >&2
    exit 2
    ;;
esac

echo "Enter the value for $service at the macOS Keychain prompt." >&2
security add-generic-password -a "$account" -s "$service" -U -w
