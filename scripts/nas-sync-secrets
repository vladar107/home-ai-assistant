#!/usr/bin/env bash

set -euo pipefail

host=${1:-${HOME_AGENT_DEPLOY_HOST:-home-nas}}
env_file=${2:-deploy/.env.nas}
account=home-ai-assistant

if [[ ! $host =~ ^[A-Za-z0-9][A-Za-z0-9._@-]*$ ]]; then
  echo "usage: $0 [ssh-alias] [env-file]" >&2
  exit 2
fi

if [[ $env_file != /* ]]; then
  env_file=$PWD/$env_file
fi
if [[ ! -f $env_file ]]; then
  echo "NAS environment file not found: $env_file" >&2
  exit 2
fi

mode=$(stat -f '%Lp' "$env_file")
if (( (8#$mode & 077) != 0 )); then
  echo "NAS environment file must not be accessible by group or others: $env_file" >&2
  exit 2
fi

set -a
# shellcheck disable=SC1090
source "$env_file"
set +a

secret_directory=${HOME_AGENT_SECRETS_PATH:-}
if [[ ! $secret_directory =~ ^/[A-Za-z0-9._/-]+$ || $secret_directory == / || $secret_directory == *'/../'* || $secret_directory == */.. ]]; then
  echo "HOME_AGENT_SECRETS_PATH must be a safe absolute NAS path without parent traversal" >&2
  exit 2
fi
for numeric in "${NAS_RUNTIME_UID:-}" "${NAS_RUNTIME_GID:-}"; do
  if [[ ! $numeric =~ ^[0-9]+$ ]]; then
    echo "NAS_RUNTIME_UID and NAS_RUNTIME_GID must be numeric" >&2
    exit 2
  fi
done

ssh -o BatchMode=yes "$host" sh -s -- \
  "$NAS_RUNTIME_UID" \
  "$NAS_RUNTIME_GID" \
  "$secret_directory" <<'REMOTE'
set -eu
test "$(id -u)" = "$1"
test "$(id -g)" = "$2"
shift 2
for directory do
  test -d "$directory"
  test ! -L "$directory"
  test "$(stat -c %a "$directory")" = 700
  test "$(stat -c %u "$directory")" = "$(id -u)"
done
REMOTE

security find-generic-password -a "$account" -s home-agent.telegram-bot-token -w >/dev/null
google_enabled=${HOME_AGENT_GOOGLE_ENABLED:-false}
if [[ $google_enabled == true ]]; then
  security find-generic-password -a "$account" -s home-agent.google-client-secret -w >/dev/null
fi
ns_enabled=${HOME_AGENT_NS_ENABLED:-false}
if [[ $ns_enabled == true ]]; then
  security find-generic-password -a "$account" -s ns.api-key -w >/dev/null
fi
ha_enabled=${HOME_AGENT_HA_ENABLED:-false}
if [[ $ha_enabled == true ]]; then
  security find-generic-password -a "$account" -s home-assistant.token -w >/dev/null
fi
grafana_enabled=${HOME_AGENT_GRAFANA_ENABLED:-false}
if [[ $grafana_enabled == true ]]; then
  security find-generic-password -a "$account" -s grafana.home-agent-token -w >/dev/null
fi
typesafe_enabled=${HOME_AGENT_TYPESAFE_ENABLED:-false}
if [[ $typesafe_enabled == true ]]; then
  security find-generic-password -a "$account" -s typesafe.api-key -w >/dev/null
fi

materialize() {
  local service=$1
  local directory=$2
  local filename=$3
  local remote_command

  remote_command="set -eu; umask 077; target='$directory/$filename'; test ! -L \"\$target\"; if test -e \"\$target\"; then test -f \"\$target\"; fi; temporary=\$(mktemp '$directory/.$filename.XXXXXX'); trap 'rm -f \"\$temporary\"' EXIT HUP INT TERM; cat >\"\$temporary\"; test -s \"\$temporary\"; chmod 600 \"\$temporary\"; mv -f \"\$temporary\" \"\$target\"; trap - EXIT HUP INT TERM"
  security find-generic-password -a "$account" -s "$service" -w \
    | ssh -o BatchMode=yes "$host" "$remote_command"
}

materialize home-agent.telegram-bot-token "$secret_directory" telegram-bot-token
if [[ $google_enabled == true ]]; then
  materialize home-agent.google-client-secret "$secret_directory" google-client-secret
fi
if [[ $ns_enabled == true ]]; then
  materialize ns.api-key "$secret_directory" ns-api-key
fi
if [[ $ha_enabled == true ]]; then
  materialize home-assistant.token "$secret_directory" ha-token
fi
if [[ $grafana_enabled == true ]]; then
  materialize grafana.home-agent-token "$secret_directory" grafana-token
fi
if [[ $typesafe_enabled == true ]]; then
  materialize typesafe.api-key "$secret_directory" typesafe-api-key
fi

echo "Runtime secret files synchronized to $host with mode 0600." >&2
