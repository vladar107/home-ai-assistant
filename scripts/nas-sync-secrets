#!/usr/bin/env bash

set -euo pipefail

stage=${1:-}
host=${2:-${HOME_AGENT_DEPLOY_HOST:-home-nas}}
env_file=${3:-deploy/.env.nas}
account=home-ai-assistant

case "$stage" in
  monitoring|app) ;;
  *)
    echo "usage: $0 monitoring|app [ssh-alias] [env-file]" >&2
    exit 2
    ;;
esac

if [[ ! $host =~ ^[A-Za-z0-9][A-Za-z0-9._@-]*$ ]]; then
  echo "invalid SSH host or alias: $host" >&2
  exit 2
fi

if [[ $env_file != /* ]]; then
  env_file=$PWD/$env_file
fi
if [[ ! -f $env_file ]]; then
  echo "NAS environment file not found: $env_file" >&2
  exit 2
fi

mode=$(stat -f '%Lp' "$env_file")
if (( (8#$mode & 077) != 0 )); then
  echo "NAS environment file must not be accessible by group or others: $env_file" >&2
  exit 2
fi

set -a
# shellcheck disable=SC1090
source "$env_file"
set +a

validate_path() {
  local name=$1
  local value=$2
  if [[ ! $value =~ ^/[A-Za-z0-9._/-]+$ || $value == / || $value == *'/../'* || $value == */.. ]]; then
    echo "$name must be a safe absolute NAS path without parent traversal" >&2
    exit 2
  fi
}

if [[ $stage == app ]]; then
  validate_path HOME_AGENT_SECRETS_PATH "${HOME_AGENT_SECRETS_PATH:-}"
else
  validate_path GRAFANA_SECRETS_PATH "${GRAFANA_SECRETS_PATH:-}"
fi
for numeric in "${NAS_RUNTIME_UID:-}" "${NAS_RUNTIME_GID:-}"; do
  if [[ ! $numeric =~ ^[0-9]+$ ]]; then
    echo "NAS_RUNTIME_UID and NAS_RUNTIME_GID must be numeric" >&2
    exit 2
  fi
done

if [[ $stage == app ]]; then
  secret_directory=$HOME_AGENT_SECRETS_PATH
else
  secret_directory=$GRAFANA_SECRETS_PATH
fi

ssh -o BatchMode=yes "$host" sh -s -- \
  "$NAS_RUNTIME_UID" \
  "$NAS_RUNTIME_GID" \
  "$secret_directory" <<'REMOTE'
set -eu
test "$(id -u)" = "$1"
test "$(id -g)" = "$2"
shift 2
for directory do
  test -d "$directory"
  test ! -L "$directory"
  test "$(stat -c %a "$directory")" = 700
  test "$(stat -c %u "$directory")" = "$(id -u)"
done
REMOTE

if [[ $stage == app ]]; then
  services=(home-agent.telegram-bot-token)
else
  services=(grafana.admin-password grafana.secret-key)
fi
for service in "${services[@]}"; do
  security find-generic-password -a "$account" -s "$service" -w >/dev/null
done

materialize() {
  local service=$1
  local directory=$2
  local filename=$3
  local remote_command

  remote_command="set -eu; umask 077; target='$directory/$filename'; test ! -L \"\$target\"; if test -e \"\$target\"; then test -f \"\$target\"; fi; temporary=\$(mktemp '$directory/.$filename.XXXXXX'); trap 'rm -f \"\$temporary\"' EXIT HUP INT TERM; cat >\"\$temporary\"; test -s \"\$temporary\"; chmod 600 \"\$temporary\"; mv -f \"\$temporary\" \"\$target\"; trap - EXIT HUP INT TERM"
  security find-generic-password -a "$account" -s "$service" -w \
    | ssh -o BatchMode=yes "$host" "$remote_command"
}

if [[ $stage == app ]]; then
  materialize home-agent.telegram-bot-token "$HOME_AGENT_SECRETS_PATH" telegram-bot-token
else
  materialize grafana.admin-password "$GRAFANA_SECRETS_PATH" admin-password
  materialize grafana.secret-key "$GRAFANA_SECRETS_PATH" secret-key
fi

echo "Runtime secret files synchronized to $host with mode 0600." >&2
