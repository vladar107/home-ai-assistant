#!/usr/bin/env bash

set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
env_file=${HOME_AGENT_ENV_FILE:-$repo_root/.env}

if [[ ! -f $env_file ]]; then
  echo "Local environment file not found: $env_file" >&2
  echo "Copy .env.example to .env and fill in both values." >&2
  exit 2
fi

set -a
# shellcheck disable=SC1090
source "$env_file"
set +a

if [[ ! ${HOME_AGENT_TELEGRAM_BOT_TOKEN:-} =~ ^[0-9]+:[A-Za-z0-9_-]+$ ]]; then
  echo "HOME_AGENT_TELEGRAM_BOT_TOKEN must contain a valid Telegram bot token" >&2
  exit 2
fi
if [[ ! ${HOME_AGENT_TELEGRAM_USER_ID:-} =~ ^[1-9][0-9]*$ ]]; then
  echo "HOME_AGENT_TELEGRAM_USER_ID must be a positive integer" >&2
  exit 2
fi

runtime_dir=$(mktemp -d "${TMPDIR:-/tmp}/home-ai-assistant.XXXXXX")

cleanup() {
  rm -rf "$runtime_dir"
}
trap cleanup EXIT HUP INT TERM

printf '%s' "$HOME_AGENT_TELEGRAM_BOT_TOKEN" >"$runtime_dir/telegram-bot-token"
chmod 600 "$runtime_dir/telegram-bot-token"
export HOME_AGENT_TELEGRAM_BOT_TOKEN=

cd "$repo_root"
HOME_AGENT_TELEGRAM_ENABLED=true \
HOME_AGENT_TELEGRAM_BOT_TOKEN_FILE="$runtime_dir/telegram-bot-token" \
HOME_AGENT_TELEGRAM_USERS_FILE='' \
go run ./cmd/home-agent
