# Copy this file outside Git as deploy/.env.nas and replace every placeholder.
# All paths are absolute paths on the NAS, selected only after the preflight.
HOME_AGENT_IMAGE=home-ai-assistant:deploy-placeholder
HOME_AGENT_VERSION=dev
HOME_AGENT_TELEGRAM_USER_ID=replace-with-positive-numeric-id
NAS_RUNTIME_UID=1000
NAS_RUNTIME_GID=1000
HOME_AGENT_NAS_ROOT=/absolute/nas/path/home-ai-assistant
HOME_AGENT_DATA_PATH=/absolute/nas/path/home-ai-assistant/home-agent/data
HOME_AGENT_SECRETS_PATH=/absolute/nas/path/home-ai-assistant/home-agent/secrets
ALLOY_DATA_PATH=/absolute/nas/path/home-ai-assistant/alloy
PROMETHEUS_DATA_PATH=/absolute/nas/path/home-ai-assistant/prometheus
TEMPO_DATA_PATH=/absolute/nas/path/home-ai-assistant/tempo
GRAFANA_DATA_PATH=/absolute/nas/path/home-ai-assistant/grafana
GRAFANA_SECRETS_PATH=/absolute/nas/path/home-ai-assistant/grafana-secrets

HOME_AGENT_HEALTH_PORT=18080
GRAFANA_PORT=3000
DEPLOYMENT_ENVIRONMENT=home
