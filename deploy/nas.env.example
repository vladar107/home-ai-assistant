# Copy this file outside Git as deploy/.env.nas and replace every placeholder.
# All paths are absolute paths on the NAS, selected only after the preflight.
NAS_RUNTIME_UID=replace-with-numeric-uid
NAS_RUNTIME_GID=replace-with-numeric-gid

# Home Agent application project.
# The deployment script derives HOME_AGENT_IMAGE_TAG from the deployed commit; a
# rollback replaces that tag in the NAS runtime.env.
HOME_AGENT_IMAGE_REPOSITORY=ghcr.io/vladar107/home-ai-assistant
HOME_AGENT_NAS_ROOT=/validated/nas/path/home-ai-assistant
HOME_AGENT_CONFIG_PATH=/validated/nas/path/home-ai-assistant/config
HOME_AGENT_DATA_PATH=/validated/nas/path/home-ai-assistant/data
HOME_AGENT_SECRETS_PATH=/validated/nas/path/home-ai-assistant/secrets
HOME_AGENT_TELEGRAM_USERS_FILE_PATH=/validated/nas/path/home-ai-assistant/config/telegram-users.json
HOME_AGENT_HEALTH_PORT=18080
HOME_AGENT_PI_PROVIDER=openai-codex
HOME_AGENT_PI_MODEL=gpt-5.6-luna:low
HOME_AGENT_PI_VERSION=0.84.1
HOME_AGENT_CONVERSATION_TURN_TIMEOUT=2m
# The zone scheduled jobs run in unless a job names its own.
HOME_AGENT_TIMEZONE=Europe/Amsterdam
HOME_AGENT_NOTION_ENABLED=false
HOME_AGENT_NOTION_CHAT_CONNECT=false
# Gmail needs the household's own Google OAuth client; its secret is the Keychain item
# home-agent.gmail-client-secret, which nas-sync-secrets installs only while this is true.
HOME_AGENT_GMAIL_ENABLED=false
HOME_AGENT_GMAIL_CLIENT_ID=replace-me.apps.googleusercontent.com
# NS train information, on for every user while this is true unless they switch it off in
# /settings. The API Portal key is the Keychain item ns.api-key, which nas-sync-secrets
# installs only while this is true.
HOME_AGENT_NS_ENABLED=false
# Web access: search, page reading, and weather, on for every user while this is true
# unless they switch it off in /settings.
HOME_AGENT_WEB_ENABLED=false
# The household's place for forecasts when a user names none; quote a name with spaces.
# HOME_AGENT_WEATHER_HOME=Amsterdam

# NAS files. The application runs as the household's own NAS user, so file access
# needs no account and no password: the directories below are mounted into the
# container by deploy/compose.app.nas.yaml, which is applied only while
# HOME_AGENT_NAS_ENABLED is true. Every path is read-only except the inbox paths,
# which are the only places a confirmed save can write. Which principal may reach
# which mount is decided by the roots file, copied to the NAS on deployment.
HOME_AGENT_NAS_ENABLED=false
HOME_AGENT_NAS_ROOTS_SOURCE=deploy/nas-roots.json
HOME_AGENT_NAS_ROOTS_FILE_PATH=/validated/nas/path/home-ai-assistant/config/nas-roots.json
HOME_AGENT_NAS_PRIMARY_HOME_PATH=/volume1/@home/replace-with-primary-user
HOME_AGENT_NAS_PRIMARY_INBOX_PATH=/volume1/@home/replace-with-primary-user/Inbox
HOME_AGENT_NAS_SECOND_HOME_PATH=/volume1/@home/replace-with-second-user
HOME_AGENT_NAS_SECOND_INBOX_PATH=/volume1/@home/replace-with-second-user/Inbox
HOME_AGENT_NAS_SHARED_PATH=/volume1/shared
HOME_AGENT_NAS_SHARED_INBOX_PATH=/volume1/shared/from-assistant

DEPLOYMENT_ENVIRONMENT=home
