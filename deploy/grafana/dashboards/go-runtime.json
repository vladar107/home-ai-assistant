{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "links": [
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": ["home-agent"],
      "targetBlank": false,
      "title": "Home Agent dashboards",
      "tooltip": "",
      "type": "dashboards",
      "url": ""
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "panels": [],
      "title": "Service",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Seconds since the process started. It returns to zero on every restart.",
      "fieldConfig": {"defaults": {"noValue": "0", "unit": "dtdurations"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "process_uptime{service_name=\"$service\"}",
          "legendFormat": "uptime",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Uptime",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Version of the running build, read from the service_version datapoint label that Alloy copies from the resource.",
      "fieldConfig": {"defaults": {"noValue": "unknown"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "id": 3,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/^service_version$/", "values": false},
        "textMode": "value"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "go_goroutine_count{service_name=\"$service\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{service_version}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Version",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Goroutines that currently exist. A count that only grows is the first sign of goroutines that never return.",
      "fieldConfig": {"defaults": {"noValue": "0", "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "id": 4,
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "go_goroutine_count{service_name=\"$service\"}",
          "legendFormat": "goroutines",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Goroutines",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Resident set size of the process, which includes memory the Go runtime has not returned to the operating system.",
      "fieldConfig": {"defaults": {"noValue": "0", "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "id": 5,
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "process_memory_usage{service_name=\"$service\"}",
          "legendFormat": "rss",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "RSS",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Operating system threads owned by the process. The Go runtime creates them for blocking system calls and never destroys them.",
      "fieldConfig": {"defaults": {"noValue": "0", "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 5},
      "id": 6,
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "process_thread_count{service_name=\"$service\"}",
          "legendFormat": "threads",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "OS threads",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Go scheduler processor limit (GOMAXPROCS), which bounds how many goroutines run at once.",
      "fieldConfig": {"defaults": {"noValue": "0", "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 5},
      "id": 7,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "go_processor_limit{service_name=\"$service\"}",
          "legendFormat": "GOMAXPROCS",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GOMAXPROCS",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Configured GOGC percentage. It sets how much the heap may grow between collections.",
      "fieldConfig": {"defaults": {"noValue": "0", "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 5},
      "id": 8,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "go_config_gogc{service_name=\"$service\"}",
          "legendFormat": "GOGC",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GOGC",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Open file descriptors. A count that grows with traffic means sockets or files are not being closed.",
      "fieldConfig": {"defaults": {"noValue": "0", "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 5},
      "id": 9,
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "process_unix_file_descriptor_count{service_name=\"$service\"}",
          "legendFormat": "descriptors",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Open file descriptors",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 9},
      "id": 10,
      "panels": [],
      "title": "Memory",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Go memory in use by class, the heap size that triggers the next collection, and GOMEMLIMIT. The limit series stays empty unless GOMEMLIMIT is set.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 0, "lineWidth": 1, "showPoints": "never"},
          "min": 0,
          "noValue": "0",
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "B"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "yellow", "mode": "fixed"}},
              {"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}}
            ]
          },
          {
            "matcher": {"id": "byFrameRefID", "options": "C"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}},
              {"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}}
            ]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 10},
      "id": 11,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (go_memory_type) (go_memory_used{service_name=\"$service\"})",
          "legendFormat": "used {{go_memory_type}}",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "go_memory_gc_goal{service_name=\"$service\"}",
          "legendFormat": "gc goal",
          "range": true,
          "refId": "B"
        },
        {
          "editorMode": "code",
          "expr": "go_memory_limit{service_name=\"$service\"}",
          "legendFormat": "GOMEMLIMIT",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Go memory by class",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Resident set size over time. It lags Go memory because the runtime returns freed pages to the operating system only gradually.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 1, "showPoints": "never"},
          "min": 0,
          "noValue": "0",
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 10},
      "id": 12,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "process_memory_usage{service_name=\"$service\"}",
          "legendFormat": "rss",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Process RSS",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Heap allocation throughput. Bytes per second is on the left axis and allocated objects per second on the right axis. High churn with a flat heap explains frequent collections.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 1, "showPoints": "never"},
          "min": 0,
          "noValue": "0",
          "unit": "Bps"
        },
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "B"},
            "properties": [
              {"id": "custom.axisPlacement", "value": "right"},
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "unit", "value": "ops"}
            ]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 10},
      "id": 13,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "rate(go_memory_allocated{service_name=\"$service\"}[$__rate_interval])",
          "legendFormat": "bytes allocated",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "rate(go_memory_allocations{service_name=\"$service\"}[$__rate_interval])",
          "legendFormat": "objects allocated",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Heap allocation rate",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 18},
      "id": 14,
      "panels": [],
      "title": "Garbage collection",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Completed garbage collection cycles per second. A rising rate together with a flat heap means allocation churn rather than a leak.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 1, "showPoints": "never"},
          "min": 0,
          "noValue": "0",
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 19},
      "id": 15,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "rate(go_memory_gc_cycles{service_name=\"$service\"}[$__rate_interval])",
          "legendFormat": "gc cycles",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GC cycles",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Stop the world pause duration by quantile. Pauses are interpolated from the runtime pause histogram, so they follow the bucket boundaries rather than individual pauses.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 0, "lineWidth": 1, "showPoints": "never"},
          "min": 0,
          "noValue": "0",
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 19},
      "id": 16,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.5, sum by (le) (rate(go_memory_gc_pause_duration_bucket{service_name=\"$service\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(go_memory_gc_pause_duration_bucket{service_name=\"$service\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "GC pause duration",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Stop the world pauses per second. Each collection cycle contributes more than one pause.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 1, "showPoints": "never"},
          "min": 0,
          "noValue": "0",
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 19},
      "id": 17,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "rate(go_memory_gc_pause_duration_count{service_name=\"$service\"}[$__rate_interval])",
          "legendFormat": "pauses",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GC pauses per second",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Share of the Go runtime's non idle CPU time spent collecting. A sustained share above a tenth means the collector, not the workload, is using the processor.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 1, "showPoints": "never"},
          "max": 1,
          "min": 0,
          "noValue": "0",
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 19},
      "id": 18,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum(rate(go_cpu_time{service_name=\"$service\", go_cpu_state=\"gc\"}[$__rate_interval])) / sum(rate(go_cpu_time{service_name=\"$service\", go_cpu_state!=\"idle\"}[$__rate_interval]))",
          "legendFormat": "gc share",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "GC share of CPU",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 27},
      "id": 19,
      "panels": [],
      "title": "CPU",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "CPU seconds per second used by the process, split into user and system time. A value of 1.0 is one fully used core.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {"group": "A", "mode": "normal"}
          },
          "min": 0,
          "noValue": "0",
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 28},
      "id": 20,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (cpu_mode) (rate(process_cpu_time{service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{cpu_mode}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Process CPU",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Go scheduler estimates of where CPU time went. The idle class is excluded so the stack shows only work, and these estimates do not add up to process CPU time.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {"group": "A", "mode": "normal"}
          },
          "min": 0,
          "noValue": "0",
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 28},
      "id": 21,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (go_cpu_state) (rate(go_cpu_time{service_name=\"$service\", go_cpu_state!=\"idle\"}[$__rate_interval]))",
          "legendFormat": "{{go_cpu_state}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Go CPU classes",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 36},
      "id": 22,
      "panels": [],
      "title": "Input and output",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Bytes per second the process read from and wrote to storage, including page cache hits. The readings come from the Linux process accounting files and stay empty elsewhere.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 1, "showPoints": "never"},
          "min": 0,
          "noValue": "0",
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 37},
      "id": 23,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (disk_io_direction) (rate(process_disk_io{service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{disk_io_direction}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Disk I/O",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Bytes per second received and transmitted over the process network interfaces, excluding loopback.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 1, "showPoints": "never"},
          "min": 0,
          "noValue": "0",
          "unit": "Bps"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 37},
      "id": 24,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (network_io_direction) (rate(process_network_io{service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{network_io_direction}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Network I/O",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Page faults per second. Minor faults are ordinary memory growth; a sustained rate of major faults means the process is reading pages back from disk.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 1, "showPoints": "never"},
          "min": 0,
          "noValue": "0",
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 37},
      "id": 25,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (system_paging_fault_type) (rate(process_paging_faults{service_name=\"$service\"}[$__rate_interval]))",
          "legendFormat": "{{system_paging_fault_type}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Page faults",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Context switches per second. Voluntary switches are waits on I/O or locks; involuntary switches mean the scheduler preempted the process because the CPU was contended.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 1, "showPoints": "never"},
          "min": 0,
          "noValue": "0",
          "unit": "ops"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 37},
      "id": 26,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
