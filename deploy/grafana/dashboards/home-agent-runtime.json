    {
      "asDropdown": false,
      "icon": "external link",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "Go Runtime",
      "tooltip": "Go memory, garbage collection, and I/O for this service",
      "type": "link",
      "url": "/d/go-runtime?var-service=home-agent"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "id": 1,
      "panels": [],
      "title": "Service",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Seconds since the application process started. It returns to zero on every container restart.",
      "fieldConfig": {"defaults": {"noValue": "0", "unit": "dtdurations"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 1},
      "id": 2,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "process_uptime{service_name=\"home-agent\"}",
          "legendFormat": "uptime",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Uptime",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Release tag of the deployed image, read from the service_version datapoint label that Alloy copies from the resource.",
      "fieldConfig": {"defaults": {"noValue": "unknown"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 1},
      "id": 3,
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "/^service_version$/", "values": false},
        "textMode": "value"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "home_agent_application_running{service_name=\"home-agent\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "{{service_version}}",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Version",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Goroutines that currently exist. The Go Runtime dashboard breaks the runtime down further.",
      "fieldConfig": {"defaults": {"noValue": "0", "unit": "short"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 12, "y": 1},
      "id": 4,
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "go_goroutine_count{service_name=\"home-agent\"}",
          "legendFormat": "goroutines",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Goroutines",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Resident set size of the Go process alone. Container memory is larger because it also holds the model runtime child process.",
      "fieldConfig": {"defaults": {"noValue": "0", "unit": "bytes"}, "overrides": []},
      "gridPos": {"h": 4, "w": 6, "x": 18, "y": 1},
      "id": 8,
      "options": {
        "colorMode": "none",
        "graphMode": "area",
        "reduceOptions": {"calcs": ["lastNotNull"], "values": false},
        "textMode": "auto"
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "process_memory_usage{service_name=\"home-agent\"}",
          "legendFormat": "rss",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "RSS",
      "type": "stat"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 5},
      "id": 9,
      "panels": [],
      "title": "CPU",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "CPU seconds per second for the whole container, including the model runtime child process. A value of 1.0 is one fully used core, which is the Compose limit drawn as the red threshold line.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {"group": "A", "mode": "normal"},
            "thresholdsStyle": {"mode": "line"}
          },
          "min": 0,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 1}
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 6},
      "id": 10,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (cpu_mode) (rate(container_cpu_time{service_name=\"home-agent\"}[$__rate_interval]))",
          "legendFormat": "{{cpu_mode}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Container CPU",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "CPU seconds per second used by the Go process alone, split into user and system time.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 30,
            "lineWidth": 1,
            "showPoints": "never",
            "stacking": {"group": "A", "mode": "normal"}
          },
          "min": 0,
          "noValue": "0",
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 6},
      "id": 11,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (cpu_mode) (rate(process_cpu_time{service_name=\"home-agent\"}[$__rate_interval]))",
          "legendFormat": "{{cpu_mode}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Process CPU",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 14},
      "id": 13,
      "panels": [],
      "title": "Memory",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Container memory usage against the 1 GiB Compose limit drawn as the dashed red line. Sustained approach to the limit precedes an out-of-memory kill.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 1, "showPoints": "never"},
          "min": 0,
          "noValue": "0",
          "unit": "bytes"
        },
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "B"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}},
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}}
            ]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 15},
      "id": 14,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "container_memory_usage{service_name=\"home-agent\"}",
          "legendFormat": "used",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "home_agent_container_memory_limit{service_name=\"home-agent\"}",
          "legendFormat": "limit",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Container memory vs limit",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Resident set size of the Go process. The gap to container memory is the model runtime child process and page cache charged to the cgroup.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 1, "showPoints": "never"},
          "min": 0,
          "noValue": "0",
          "unit": "bytes"
        },
        "overrides": []
      },
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 15},
      "id": 15,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "process_memory_usage{service_name=\"home-agent\"}",
          "legendFormat": "rss",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Process RSS",
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 23},
      "id": 20,
      "panels": [],
      "title": "Connections and processes",
      "type": "row"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "SQLite connection pool occupancy against the configured maximum. Used connections at the maximum mean callers are queueing.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 1, "showPoints": "never"},
          "min": 0,
          "noValue": "0",
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "B"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}},
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}}
            ]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 24},
      "id": 22,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (db_client_connection_state) (db_client_connection_count{service_name=\"home-agent\", db_client_connection_pool_name=\"sqlite\"})",
          "legendFormat": "{{db_client_connection_state}}",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "db_client_connection_max{service_name=\"home-agent\", db_client_connection_pool_name=\"sqlite\"}",
          "legendFormat": "max",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "SQLite pool",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "How often callers waited for a SQLite connection and how much time they spent waiting. Waits per second are on the left axis and seconds waited per second on the right axis.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 1, "showPoints": "never"},
          "min": 0,
          "noValue": "0",
          "unit": "ops"
        },
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "B"},
            "properties": [
              {"id": "custom.axisPlacement", "value": "right"},
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "unit", "value": "s"}
            ]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 24},
      "id": 23,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "rate(home_agent_store_connection_waits{service_name=\"home-agent\"}[$__rate_interval])",
          "legendFormat": "waits",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "rate(home_agent_store_connection_wait_time{service_name=\"home-agent\"}[$__rate_interval])",
          "legendFormat": "time waited",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "SQLite waits",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Processes and threads in the container cgroup against the Compose pids limit of 256, drawn as the dashed red line.",
      "fieldConfig": {
        "defaults": {
          "custom": {"fillOpacity": 10, "lineWidth": 1, "showPoints": "never"},
          "min": 0,
          "noValue": "0",
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {"id": "byFrameRefID", "options": "B"},
            "properties": [
              {"id": "color", "value": {"fixedColor": "red", "mode": "fixed"}},
              {"id": "custom.fillOpacity", "value": 0},
              {"id": "custom.lineStyle", "value": {"dash": [10, 10], "fill": "dash"}}
            ]
          }
        ]
      },
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 24},
      "id": 24,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "home_agent_container_pids_count{service_name=\"home-agent\"}",
          "legendFormat": "pids",
          "range": true,
          "refId": "A"
        },
        {
          "editorMode": "code",
          "expr": "home_agent_container_pids_limit{service_name=\"home-agent\"}",
          "legendFormat": "limit",
          "range": true,
          "refId": "B"
        }
      ],
      "title": "Container PIDs vs limit",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
