    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "description": "Health endpoint traffic. A steady rate is the container health check; a missing rate means the check is not running.",
      "fieldConfig": {"defaults": {"noValue": "0", "unit": "reqps"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 40},
      "id": 21,
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "desc"}
      },
      "targets": [
        {
          "editorMode": "code",
          "expr": "sum by (home_agent_endpoint, home_agent_result) (rate(home_agent_http_server_requests{service_name=\"home-agent\"}[$__rate_interval]))",
