# Copy this file to .env for local Telegram development.
HOME_AGENT_TELEGRAM_ENABLED=true
HOME_AGENT_TELEGRAM_BOT_TOKEN=
HOME_AGENT_TELEGRAM_USER_ID=

# Local model conversation is opt-in and requires Pi 1.0.0 with an
# authenticated openai-codex profile. The production image does not include Pi.
HOME_AGENT_CONVERSATION_ENABLED=false
HOME_AGENT_PI_BINARY=pi
# Set this when a GUI-launched GoLand cannot find the Node runtime used by Pi.
HOME_AGENT_PI_NODE_BINARY=
HOME_AGENT_PI_PROVIDER=openai-codex
HOME_AGENT_PI_MODEL=gpt-5.6-luna:low
HOME_AGENT_PI_VERSION=1.0.0
HOME_AGENT_CONVERSATION_TURN_TIMEOUT=2m

# Per-user Notion connection. Requires conversation. Chat connect lets a user
# paste a token into the chat after pressing Connect Notion in /settings.
HOME_AGENT_NOTION_ENABLED=false
HOME_AGENT_NOTION_CHAT_CONNECT=false

# Web search, page reading, and weather: on for every user while this is true, and
# switched off per user in /settings.
# Requires conversation; search loads the vendored extension from this checkout.
HOME_AGENT_WEB_ENABLED=false
HOME_AGENT_PI_WEB_SEARCH_EXTENSION=/absolute/path/to/home-ai-assistant/third_party/pi-web-search/src/index.ts
HOME_AGENT_WEATHER_HOME=

# NS train information: on for every user while a key is set, and switched off per user in
# /settings. Requires conversation. Set the key or a 0600 file holding it, not both.
HOME_AGENT_NS_API_KEY=
HOME_AGENT_NS_API_KEY_FILE=

# Bus information from OVapi: on for every user while this is true, and switched off per user in
# /settings. Requires conversation. The home stop is any timing point code of the household's stop;
# planned trips go through Transitous, whose terms ask for a contact such as an email address.
HOME_AGENT_BUS_ENABLED=false
HOME_AGENT_BUS_HOME_STOP=
HOME_AGENT_BUS_CONTACT=

# TypeSafe safety checks: offered in /settings while a key is set, off for every user until they
# turn it on. Requires conversation. Set the key or a 0600 file holding it, not both.
HOME_AGENT_TYPESAFEAI_KEY=
HOME_AGENT_TYPESAFEAI_KEY_FILE=
