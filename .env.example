# Copy this file to .env for local Telegram development.
HOME_AGENT_TELEGRAM_ENABLED=true
HOME_AGENT_TELEGRAM_BOT_TOKEN=
HOME_AGENT_TELEGRAM_USER_ID=

# Local model conversation is opt-in and requires Pi 1.0.0 with an
# authenticated openai-codex profile. The production image does not include Pi.
HOME_AGENT_CONVERSATION_ENABLED=false
HOME_AGENT_PI_BINARY=pi
# Set this when a GUI-launched GoLand cannot find the Node runtime used by Pi.
HOME_AGENT_PI_NODE_BINARY=
HOME_AGENT_PI_PROVIDER=openai-codex
HOME_AGENT_PI_MODEL=gpt-6-luna:medium
HOME_AGENT_PI_VERSION=1.0.0
HOME_AGENT_CONVERSATION_TURN_TIMEOUT=2m

# Per-user Notion connection. Requires conversation. Chat connect lets a user
# paste a token into the chat after pressing Connect Notion in /settings.
HOME_AGENT_NOTION_ENABLED=false
HOME_AGENT_NOTION_CHAT_CONNECT=false

# Web search, page reading, and weather: on for every user while this is true, and
# switched off per user in /settings.
# Requires conversation; search loads the vendored extension from this checkout.
HOME_AGENT_WEB_ENABLED=false
HOME_AGENT_PI_WEB_SEARCH_EXTENSION=/absolute/path/to/home-ai-assistant/third_party/pi-web-search/src/index.ts
HOME_AGENT_WEATHER_HOME=

# NS train information: on for every user while a key is set, and switched off per user in
# /settings. Requires conversation. Set the key or a 0600 file holding it, not both.
HOME_AGENT_NS_API_KEY=
HOME_AGENT_NS_API_KEY_FILE=

# Home Assistant: on for every user while a token is set, and switched off per user in /settings.
# Requires conversation. Set the token or a 0600 file holding it, not both. The URL is optional
# and defaults to the home edge address.
HOME_AGENT_HA_TOKEN=
HOME_AGENT_HA_TOKEN_FILE=
HOME_AGENT_HA_URL=

# Grafana: metrics and logs for the named principals only, who can switch it off in /settings.
# Requires conversation. Set a Viewer service-account token or a 0600 file holding it, not both.
# The URL defaults to http://grafana:3000 on the home-observability network; from the Mac, use
# the NAS's LAN address.
HOME_AGENT_GRAFANA_TOKEN=
HOME_AGENT_GRAFANA_TOKEN_FILE=
HOME_AGENT_GRAFANA_URL=
HOME_AGENT_GRAFANA_PRINCIPALS=

# Bus information from OVapi: on for every user while this is true, and switched off per user in
# /settings. Requires conversation. The home stop is any timing point code of the household's stop;
# planned trips go through Transitous, whose terms ask for a contact such as an email address.
HOME_AGENT_BUS_ENABLED=false
HOME_AGENT_BUS_HOME_STOP=
HOME_AGENT_BUS_CONTACT=

# TypeSafe safety checks: offered in /settings while a key is set, off for every user until they
# turn it on. Requires conversation. Set the key or a 0600 file holding it, not both.
HOME_AGENT_TYPESAFEAI_KEY=
HOME_AGENT_TYPESAFEAI_KEY_FILE=

# Shared locations: a pin, venue, or live location shared in chat tells your turns where you are
# until it expires, and adds the nearby_places tool. Requires conversation. Only the latest position
# is kept; these durations (Go syntax, such as 1h or 15m) bound how long it is used and kept.
# Addresses come from Transitous and places from OpenStreetMap's Overpass, whose terms ask for a
# contact such as an email address.
HOME_AGENT_LOCATION_ENABLED=false
HOME_AGENT_LOCATION_PIN_TTL=1h
HOME_AGENT_LOCATION_LIVE_SILENCE=1h
HOME_AGENT_LOCATION_LIVE_GRACE=15m
HOME_AGENT_LOCATION_PRUNE_INTERVAL=10m
HOME_AGENT_LOCATION_CONTACT=

# Background tasks: a long request (a month of mail, research across many pages) is handed to a
# sub-agent that runs beside the chat and reports back; /tasks lists and cancels them. Requires
# conversation. The timeout caps one task's wall time, between 1m and 6h.
HOME_AGENT_TASKS_ENABLED=false
HOME_AGENT_TASK_TIMEOUT=60m

# Watches: a departure, saved route, or set of stations is checked in code during a daily window,
# and the user hears only when something changes; /jobs lists them. Requires conversation. No kind
# can be checked yet, so turning this on offers no watch tools until the checks land.
HOME_AGENT_WATCHES_ENABLED=false
