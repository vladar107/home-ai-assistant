{
  "id": "ph3-answer-with-hidden-event-address",
  "title": "Asked where an event from the week's overview is, the assistant answers with its placeholder, so the user sees the real street address",
  "tags": [
    "regression",
    "placeholders"
  ],
  "kind": "hidden-value-withheld",
  "clock": {
    "local": "2026-03-10T16:00",
    "zone": "Europe/Berlin"
  },
  "user": {
    "name": "Sam"
  },
  "world": {
    "calendar": {
      "events": [
        {
          "id": "ev1",
          "summary": "Project sync",
          "start": "2026-03-10T17:00",
          "end": "2026-03-10T17:30",
          "location": "Zoom"
        },
        {
          "id": "ev2",
          "summary": "Dentist",
          "start": "2026-03-11T09:00",
          "end": "2026-03-11T09:30",
          "location": "Harbour Road 5, Eastbrook"
        },
        {
          "id": "ev3",
          "summary": "Team dinner",
          "start": "2026-03-12T19:00",
          "end": "2026-03-12T21:00",
          "location": "Market Square 9, Eastbrook"
        },
        {
          "id": "ev4",
          "summary": "Board games",
          "start": "2026-03-14T11:00",
          "end": "2026-03-14T19:00",
          "location": "Lindenlaan 12, Westfield"
        }
      ]
    }
  },
  "steps": [
    {
      "say": "Что у меня на этой неделе?",
      "expect": {
        "calls": [
          {
            "tool": "calendar_events"
          }
        ]
      }
    },
    {
      "say": "А где будут настолки?",
      "expect": {
        "reply": {
          "contains": [
            "Lindenlaan 12"
          ],
          "not_contains": [
            "(hidden place)",
            "⟦"
          ],
          "not_matches": [
            "(?i)\\b(email|phone|address)-[a-z2-7]{6}\\b",
            "(?i)скрыт"
          ]
        }
      }
    }
  ]
}
