{
  "id": "d2-memory-promise",
  "title": "A promise to use knots is backed by a saved instruction",
  "tags": [
    "regression"
  ],
  "kind": "claimed-done",
  "clock": {
    "local": "2026-03-10T15:00",
    "zone": "Europe/Berlin"
