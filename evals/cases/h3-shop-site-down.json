{
  "id": "h3-shop-site-down",
  "title": "A down shop site is checked, answered and a watch is offered",
  "tags": [
    "happy"
  ],
  "kind": "happy",
  "clock": {
    "local": "2026-03-10T10:00",
    "zone": "Europe/Berlin"
  },
  "user": {
    "name": "Sam",
    "language": "ru",
    "memory": [
      "Любимый магазин: Northwind Shop."
    ]
  },
  "world": {
    "weather": {
      "places": [
        {
          "name": "Eastbrook",
          "latitude": 52.1,
          "longitude": 5.1,
          "country": "Netherlands",
          "country_code": "NL",
          "timezone": "Europe/Berlin"
        }
      ]
    },
    "pages": {
      "pages": [
        {
          "host": "northwind-shop.nl",
          "path": "/",
          "status": 503,
          "title": "Service unavailable",
          "body": "Temporarily unavailable. We are working on it."
        }
      ]
    }
  },
  "steps": [
    {
      "say": "сайт и приложение магазина не работают? https://northwind-shop.nl",
      "expect": {
        "calls": [
          {
            "tool": "fetch_page",
            "min": 1,
            "args": [
              {
                "path": "url",
                "contains": "northwind-shop.nl"
              }
            ]
          }
        ],
        "reply": {
          "language": "ru",
          "matches": [
            "(?i)(слежу|прослежу|сообщ|уведом|наблюд|отслеж|watch)",
            "(?i)(не работа|не открыва|недоступ|503|сбой|лежит)"
          ]
        }
      }
    }
  ],
  "rubric": [
    "Does the reply answer, from the search results, whether the shop's site and app are down?"
  ]
}
