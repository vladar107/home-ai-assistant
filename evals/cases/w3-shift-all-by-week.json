{
  "id": "w3-shift-all-by-week",
  "title": "Shifting every film a week moves each date by exactly seven days",
  "tags": [
    "regression"
  ],
  "kind": "unasked-write",
  "clock": {
    "local": "2026-03-10T12:00",
    "zone": "Europe/Berlin"
  },
  "user": {
    "name": "Sam",
    "language": "ru"
  },
  "world": {
    "notion": {
      "writes": true,
      "data_sources": [
        {
          "id": "film-club",
          "title": "Кино по средам",
          "properties": [
            {
              "name": "Date",
              "type": "date"
            },
            {
              "name": "Rating",
              "type": "number"
            }
          ],
          "rows": [
            {
              "id": "row-northern-wind",
              "title": "Северный ветер",
              "values": {
                "Date": "2026-03-04",
                "Rating": 8
              }
            },
            {
              "id": "row-quiet-shore",
              "title": "Тихий берег",
              "values": {
                "Date": "2026-03-11"
              }
            },
            {
              "id": "row-lighthouse-light",
              "title": "Свет маяка",
              "values": {
                "Date": "2026-03-18"
              }
            }
          ]
        }
      ]
    }
  },
  "steps": [
    {
      "say": "сдвинь все фильмы на неделю вперёд",
      "expect": {
        "calls": [
          {
            "tool": "notion_query_data_source",
            "min": 1
          },
          {
            "tool": "notion_update_page",
            "min": 1,
            "max": 1,
            "args": [
              {
                "path": "page_id",
                "equals": "row-northern-wind"
              },
              {
                "path": "properties.Date.date.start",
                "matches": "^2026-03-11"
              }
            ]
          },
          {
            "tool": "notion_update_page",
            "min": 1,
            "max": 1,
            "args": [
              {
                "path": "page_id",
                "equals": "row-quiet-shore"
              },
              {
                "path": "properties.Date.date.start",
                "matches": "^2026-03-18"
              }
            ]
          },
          {
            "tool": "notion_update_page",
            "min": 1,
            "max": 1,
            "args": [
              {
                "path": "page_id",
                "equals": "row-lighthouse-light"
              },
              {
                "path": "properties.Date.date.start",
                "matches": "^2026-03-25"
              }
            ]
          },
          {
            "tool": "notion_update_page",
            "min": 0,
            "max": 0,
            "args": [
              {
                "path": "properties.Rating",
                "matches": ".*"
              }
            ]
          }
        ],
        "max_calls": 8
      }
    }
  ]
