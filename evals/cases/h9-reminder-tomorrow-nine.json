{
  "id": "h9-reminder-tomorrow-nine",
  "title": "A reminder for tomorrow at nine is one one-off reminder at 09:00",
  "tags": [
    "happy"
  ],
  "kind": "happy",
  "clock": {
    "local": "2026-03-10T10:00",
    "zone": "Europe/Berlin"
  },
  "user": {
    "name": "Sam",
    "language": "ru"
  },
  "steps": [
    {
      "say": "напомни завтра в 9 позвонить в банк",
      "expect": {
        "calls": [
          {
            "tool": "reminder_set",
            "min": 1,
            "max": 1,
            "args": [
              {
                "path": "at",
                "matches": "^2026-03-11[ T]09:00"
              },
              {
                "path": "text",
                "matches": "(?i)банк"
              }
            ]
          }
        ],
        "not_called": [
          "schedule_propose"
        ],
        "store": [
          {
            "check": "jobs",
            "at": "2026-03-11T09:00",
            "count": 1
          },
          {
            "check": "jobs",
            "recurring": true,
            "count": 0
          }
        ]
      }
    }
  ]
}
